{
  "name": "plweb2",
  "private": true,
  "version": "1.2.4",
  "type": "module",
  "main": "./dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --build  --force && vite build",
    "preview": "vite preview",
    "eslint": "npx eslint src/**/*.{ts,vue,js,css} && node scripts/check-i18n.mjs",
    "eslint:fix": "npx eslint src/**/*.{ts,vue,js,css} --fix && node scripts/check-i18n.mjs",
    "format": "npx prettier --write ./**/*.{ts,vue,js,css} ",
    "lint:i18n": "node scripts/check-i18n.mjs",
    "electron:dev": "vite --mode electron",
    "electron:build": "vite build --mode electron-build && electron-builder",
    "electron:preview": "vite preview --mode electron"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.45",
    "md-editor-v3": "^6.5.0",
    "mermaid": "^11.16.1",
    "prettier": "^3.6.2",
    "vue": "^3.5.24",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.60.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.21",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.2.0",
    "naive-ui": "^2.43.1",
    "playwright": "^1.60.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "2.2.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.1"
  },
  "description": "Physics Lab Web - Online community",
  "author": "TurtleSim"
}
